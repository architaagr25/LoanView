# Copy this file to .env and replace the placeholder values.
# .env is git-ignored and must never be committed.

# development | production | test
NODE_ENV=development

PORT=5000

# MongoDB connection string. The path segment after the host is the database
# name — omit it and the driver silently uses a database called "test".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/loanview?retryWrites=true&w=majority

# Signing key for JWTs. Must be at least 32 characters and unique per
# environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Accepts any value the jsonwebtoken library understands, e.g. 30m, 12h, 7d
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
# Include the deployed frontend URL in production, with no trailing slash.
CORS_ORIGINS=http://localhost:3000

# Maximum salary slip upload size in bytes (5 MB)
MAX_UPLOAD_BYTES=5242880
