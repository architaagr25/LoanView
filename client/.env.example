# Copy this file to .env.local and adjust if needed.
# .env.local is git-ignored.

# Base URL of the backend API, including the /api path and no trailing slash.
# In production this is the deployed backend URL, for example:
#   https://loanview-api.onrender.com/api
#
# NEXT_PUBLIC_ makes the value available to browser code. Everything this app
# sends to the API travels through the browser anyway, so there is nothing
# secret here — never put a real secret behind this prefix, as it is compiled
# into the JavaScript bundle and readable by anyone.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
